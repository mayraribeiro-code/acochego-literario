generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TipoUsuario {
  comum
  admin
}

// Conta guarda apenas credenciais de acesso; Usuario guarda o perfil
// e é o ponto de relação com o restante do domínio.
model Conta {
  id        String   @id @default(uuid())
  email     String   @unique
  senhaHash String   @map("senha_hash")
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuario Usuario?

  @@map("contas")
}

model Usuario {
  id          String      @id @default(uuid())
  contaId     String      @unique @map("conta_id")
  nome        String
  tipoUsuario TipoUsuario @default(comum) @map("tipo_usuario")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  conta      Conta              @relation(fields: [contaId], references: [id], onDelete: Cascade)
  compras    Compra[]
  progressos ProgressoLeitura[]

  @@map("usuarios")
}

enum StatusCompra {
  iniciada
  confirmada
  cancelada
  falha
}

model Autor {
  id        String   @id @default(uuid())
  nome      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  livros Livro[]

  @@map("autores")
}

model Genero {
  id        String   @id @default(uuid())
  nome      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  livros Livro[]

  @@map("generos")
}

// Valores em dinheiro ficam em centavos (inteiro) para evitar erro de arredondamento.
// A capa é desenhada pelo frontend a partir das três cores.
model Livro {
  id              String   @id @default(uuid())
  titulo          String
  sinopse         String
  ano             Int
  precoCentavos   Int      @map("preco_centavos")
  formato         String
  disponivel      Boolean  @default(true)
  ativo           Boolean  @default(true)
  capaCorInicio   String   @map("capa_cor_inicio")
  capaCorFim      String   @map("capa_cor_fim")
  capaCorTexto    String   @map("capa_cor_texto")
  avaliacao       Float    @default(0)
  totalAvaliacoes Int      @default(0) @map("total_avaliacoes")
  autorId         String   @map("autor_id")
  generoId        String   @map("genero_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  autor      Autor              @relation(fields: [autorId], references: [id])
  genero     Genero             @relation(fields: [generoId], references: [id])
  compras    Compra[]
  arquivos   ArquivoDigital[]
  progressos ProgressoLeitura[]

  @@index([autorId])
  @@index([generoId])
  @@map("livros")
}

// Uma compra é de um único livro; o mesmo usuário não compra o mesmo livro duas vezes.
// valorCentavos guarda o preço pago, que não muda se o preço do livro mudar depois.
model Compra {
  id            String       @id @default(uuid())
  usuarioId     String       @map("usuario_id")
  livroId       String       @map("livro_id")
  valorCentavos Int          @map("valor_centavos")
  status        StatusCompra @default(confirmada)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  livro   Livro   @relation(fields: [livroId], references: [id])

  @@unique([usuarioId, livroId])
  @@index([livroId])
  @@map("compras")
}

enum FormatoArquivo {
  PDF
  EPUB
}

// Arquivo do livro guardado no servidor (pasta definida em STORAGE_DIR).
// O caminho é gerado pela API, nunca vem do nome enviado no upload.
model ArquivoDigital {
  id           String         @id @default(uuid())
  livroId      String         @map("livro_id")
  formato      FormatoArquivo
  nomeOriginal String         @map("nome_original")
  caminho      String         @unique
  tamanhoBytes Int            @map("tamanho_bytes")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  livro Livro @relation(fields: [livroId], references: [id], onDelete: Cascade)

  @@unique([livroId, formato])
  @@map("arquivos_digitais")
}

// Onde o usuário parou em cada formato do livro. "posicao" é o número da
// página no PDF ou o CFI (localização do epub.js) no EPUB.
model ProgressoLeitura {
  id         String         @id @default(uuid())
  usuarioId  String         @map("usuario_id")
  livroId    String         @map("livro_id")
  formato    FormatoArquivo
  posicao    String
  percentual Int
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  livro   Livro   @relation(fields: [livroId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, livroId, formato])
  @@index([livroId])
  @@map("progressos_leitura")
}
